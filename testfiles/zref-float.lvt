\input{regression-test}

\documentclass{article}
\usepackage{tikz}
\usepackage{zref-user,zref-abspage,zref-clever}
\usetikzlibrary{external}
\usetikzlibrary{pageref}

% l3build keeps the test source as .lvt, which the subjob that externalizes a
% picture must input explicitly.
\tikzset{
  external/system call={%
    pdflatex \tikzexternalcheckshellescape -halt-on-error
    -interaction=batchmode -jobname "\image"
    "\string\def\string\tikzexternalrealjob{\jobname}%
    \string\input{\jobname.lvt}"%
  },
}
\tikzexternalize

\begin{document}
Text.

% The figure body is read on page 1, but the float lands on page 2.
\begin{figure}[p]
  \tikz \node {\refstepcounter{figure}\label{fig:inside}\zlabel{fig:zinside}A};
  \label{fig:outside}\zlabel{fig:zoutside}
\end{figure}

\clearpage

\START
% A failed externalization typesets the picture inline, which yields the
% correct page without exercising the library.
\IfFileExists{\jobname-figure0.pdf}{%
  \TYPE{Picture externalized}%
}{%
  \TYPE{Picture not externalized}%
}
\makeatletter
\TYPE{Outside: page \zref@extractdefault{fig:zoutside}{page}{undefined}, absolute page \zref@extractdefault{fig:zoutside}{abspage}{undefined}, page counter \zref@extractdefault{fig:zoutside}{zc@pgval}{undefined}}
\TYPE{Inside: page \zref@extractdefault{fig:zinside}{page}{undefined}, absolute page \zref@extractdefault{fig:zinside}{abspage}{undefined}, page counter \zref@extractdefault{fig:zinside}{zc@pgval}{undefined}}
\makeatother
\END
