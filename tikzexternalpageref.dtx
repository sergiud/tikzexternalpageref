% \date{\FormatISODate\filedate}
%
% \maketitle
%
% \begin{abstract}
% This library corrects the page numbers of labels in externalized TikZ
% figures, so that \cs{pageref} and page references of packages such as
% \textsf{varioref}, \textsf{cleveref} and \textsf{zref} point to the page the figure
% lands on.
% \end{abstract}
%
% \tableofcontents
%
% \section{Motivation}
%
% TikZ is a library for drawing figures directly in \LaTeX\ which also allows to
% externalize complex figures. Externalization of figures greatly reduces the
% overall compilation time of the main document. While TikZ allows to refer to
% labels created in externalized pictures, the support is limited. Specifically,
% referring to page numbers using the \cs{pageref} command does not work out of
% the box. The typeset page number is the page where the source of the picture
% stands rather than the page where the picture lands. \cs{pageref}
% support is, however, essential for usage of packages such as \textsf{varioref}.
%
% \Cref{sec:background} provides background information why the issue arises and
% how this package solves it.
%
% Only page references are affected. Labels in externalized pictures already
% refer to the correct figure, section or equation numbers without the
% library.
%
% \section{Requirements}
%
% The library requires the TikZ \textsf{external} library, a \LaTeX\ kernel of
% 2020-10-01 or later and the \textsf{etoolbox} package. It runs entirely in
% \TeX\ and needs neither external programs nor the \verb|-shell-escape|
% option. TikZ itself still needs \verb|-shell-escape| to externalize
% pictures in its default mode, but not in the mode \texttt{list and make}.
%
% \section{Usage}
%
% Load the \textsf{pageref} TikZ library after the \textsf{external} library in
% the preamble of your document:
% \begin{verbatim}
%   \usetikzlibrary{external}
%   \usetikzlibrary{pageref}
%   \tikzexternalize
% \end{verbatim}
% No other changes are needed. Without the \textsf{external} library, the
% library does nothing.
%
% \section{Technical Background}
% \label{sec:background}
%
% During externalization, TikZ writes auxiliary information, such as labels, to
% \texttt{.dpth} files. The picture is compiled in a separate run, which knows
% only the page where the source of the picture stands. The main document
% reads the \texttt{.dpth} files and copies their lines to the \texttt{.aux}
% file immediately, so labels keep that page, although a float may carry the
% picture to a later page.
%
% The library defers each label line until the page is shipped out. It wraps
% the line in \cs{tikzexternalpagerefrelabel} together with the page at
% shipout. When the \texttt{.aux} file is read, the wrapper replaces only the
% page fields of the label, that is, the page of \LaTeX\ and \textsf{cleveref}
% labels and the page, absolute page and page counter of \textsf{zref} labels.
% All other fields, as well as all other lines of the \texttt{.dpth} file,
% stay as TikZ writes them.
%
% \MaybeStop{\PrintChanges\PrintIndex}
%
% \section{Implementation}
%
% \subsection{Package}
%
%    \begin{macrocode}
%<*library>
%    \end{macrocode}
% Load required packages.
%    \begin{macrocode}
\RequirePackage{etoolbox}
%    \end{macrocode}
% \begin{macro}{\tikzexternalpagerefrelabel}
% \cs{tikzexternalpagerefrelabel} wraps each label line of an externalized
% picture in the \texttt{.aux} file. Its arguments are the page, the value of
% the page counter and the absolute page at shipout, and the label line. The
% macro runs the line with \cs{newlabel} and \cs{zref@newlabel} redefined to
% substitute the page.
%    \begin{macrocode}
\long\def\tikzexternalpagerefrelabel#1#2#3#4{%
  \begingroup
    \let\tikzexternalpageref@newlabel\newlabel
    \let\tikzexternalpageref@zrefnewlabel\zref@newlabel
    \def\newlabel##1##2{%
      \tikzexternalpageref@relabel{##1}{#1}##2\@nil}%
    \def\zref@newlabel##1##2{%
      \tikzexternalpageref@zrelabel{##1}{#1}{#2}{#3}{##2}}%
    #4%
  \endgroup}
%    \end{macrocode}
% \end{macro}
% The arguments are the key, the page, and the fields of the label: its
% text, its page and the fields \textsf{hyperref} adds, if any.
%    \begin{macrocode}
\long\def\tikzexternalpageref@relabel#1#2#3#4#5\@nil{%
  \tikzexternalpageref@ifcrefpage{#4}%
    {\tikzexternalpageref@crefpage#4\@nil{#2}}%
    {\def\tikzexternalpageref@page{#2}}%
  \edef\tikzexternalpageref@line{%
    \noexpand\tikzexternalpageref@newlabel{\unexpanded{#1}}{%
      {\unexpanded{#3}}%
      {\unexpanded\expandafter{\tikzexternalpageref@page}}%
      \unexpanded{#5}}}%
  \tikzexternalpageref@line}
%    \end{macrocode}
% \textsf{cleveref} writes the page field as
% \verb|[|\meta{page}\verb|][|\meta{counter}\verb|][|\meta{prefix}\verb|]|\meta{page}
% and defers only the trailing page to shipout, which is the part to replace.
%    \begin{macrocode}
\long\def\tikzexternalpageref@ifcrefpage#1{%
  \tikzexternalpageref@ifcrefpage@#1\relax\@nil}
\long\def\tikzexternalpageref@ifcrefpage@#1#2\@nil{%
  \ifx[#1\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
\long\def\tikzexternalpageref@crefpage[#1][#2][#3]#4\@nil#5{%
  \def\tikzexternalpageref@page{[#1][#2][#3]#5}}
%    \end{macrocode}
% \textsf{zref} stores properties as \verb|\name{value}|. Replace the page,
% the absolute page and the page counter that \textsf{zref-clever} keeps. The
% arguments are the key, the page, the page counter, the absolute page and
% the properties.
%    \begin{macrocode}
\edef\tikzexternalpageref@name@page{\string\page}
\edef\tikzexternalpageref@name@abspage{\string\abspage}
\edef\tikzexternalpageref@name@pgval{\string\zc@pgval}
\long\def\tikzexternalpageref@zrelabel#1#2#3#4#5{%
  \def\tikzexternalpageref@zpage{#2}%
  \def\tikzexternalpageref@zcounter{#3}%
  \def\tikzexternalpageref@zabspage{#4}%
  \toks@{}%
  \tikzexternalpageref@zprops#5\tikzexternalpageref@zend{}%
  \edef\tikzexternalpageref@line{%
    \noexpand\tikzexternalpageref@zrefnewlabel
      {\unexpanded{#1}}{\the\toks@}}%
  \tikzexternalpageref@line}
\def\tikzexternalpageref@zend{\tikzexternalpageref@zend}
\long\def\tikzexternalpageref@zprops#1#2{%
  \ifx#1\tikzexternalpageref@zend
  \else
    \edef\tikzexternalpageref@zname{\string#1}%
    \ifx\tikzexternalpageref@zname\tikzexternalpageref@name@page
      \tikzexternalpageref@zput#1\tikzexternalpageref@zpage
    \else\ifx\tikzexternalpageref@zname\tikzexternalpageref@name@pgval
      \tikzexternalpageref@zput#1\tikzexternalpageref@zcounter
    \else\ifx\tikzexternalpageref@zname\tikzexternalpageref@name@abspage
      \ifx\tikzexternalpageref@zabspage\@empty
        \toks@\expandafter{\the\toks@#1{#2}}%
      \else
        \tikzexternalpageref@zput#1\tikzexternalpageref@zabspage
      \fi
    \else
      \toks@\expandafter{\the\toks@#1{#2}}%
    \fi\fi\fi
    \expandafter\tikzexternalpageref@zprops
  \fi}
%    \end{macrocode}
% Append the property \verb|#1| with the value stored in the macro \verb|#2|.
%    \begin{macrocode}
\def\tikzexternalpageref@zput#1#2{%
  \toks@\expandafter\expandafter\expandafter{%
    \expandafter\the\expandafter\toks@\expandafter#1\expandafter{#2}}}
%    \end{macrocode}
% Write a label line at shipout. \verb|\protected@write| keeps \cs{thepage}
% unexpanded until then. The absolute page counter exists only with packages
% such as \textsf{zref-abspage}. The doubled \cs{unexpanded} survives both the
% expansion of \verb|\protected@write| and the one at shipout.
%    \begin{macrocode}
\newcommand\tikzexternalpageref@deferlabel[1]{%
  \protected@write\@auxout{}{%
    \string\tikzexternalpagerefrelabel{\thepage}%
      {\noexpand\the\noexpand\c@page}%
      {\@ifundefined{c@abspage}{}{\noexpand\the\noexpand\c@abspage}}%
      {\unexpanded{\unexpanded{#1}}}}}
%    \end{macrocode}
% Whether the first token of a \texttt{.dpth} line starts a label.
%    \begin{macrocode}
\newcommand\tikzexternalpageref@iflabelline{%
  \expandafter\ifx\pgf@first\newlabel
    \expandafter\@firstoftwo
  \else
    \expandafter\ifx\pgf@first\zref@newlabel
      \expandafter\expandafter\expandafter\@firstoftwo
    \else
      \expandafter\expandafter\expandafter\@secondoftwo
    \fi
  \fi}
%    \end{macrocode}
% Defer the label lines of \texttt{.dpth} files and leave the remaining lines
% to TikZ. The \texttt{.aux} file provides the wrapper itself, so that it
% stays readable without the library.
%    \begin{macrocode}
\newcommand\tikzexternalpageref@patch{%
  \let\tikzexternalpageref@dpthline
    \pgfincludeexternalgraphics@read@dpth@line
  \long\def\pgfincludeexternalgraphics@read@dpth@line##1%
      \pgfincludeexternalgraphics@read@dpth@line@EOI{%
    \pgfincludeexternalgraphics@read@dpth@line@getfirst##1%
      \pgfincludeexternalgraphics@read@dpth@line@EOI
    \tikzexternalpageref@iflabelline
      {\if@filesw\tikzexternalpageref@deferlabel{##1}\fi}%
      {\tikzexternalpageref@dpthline##1%
        \pgfincludeexternalgraphics@read@dpth@line@EOI}}%
  \AtBeginDocument{%
    \if@filesw
      \immediate\write\@auxout{%
        \string\providecommand
        \string\tikzexternalpagerefrelabel[4]{\string##4}}%
    \fi}}
%    \end{macrocode}
% Without the TikZ \textsf{external} library, pictures are not externalized and
% there is nothing to patch. Externalized pictures need no patch either.
%    \begin{macrocode}
\AtEndPreamble{%
  \ifx\tikzifexternalizing\@undefined
    \PackageInfo{tikzexternalpageref}{%
      tikz external library not loaded, not patching}%
  \else
    \tikzifexternalizing{}{\tikzexternalpageref@patch}%
  \fi}
%    \end{macrocode}
%
